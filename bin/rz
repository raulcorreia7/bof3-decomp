#!/bin/sh
# Read retail bytes through a saved Rizin project, or use raw mapping for loose bytes.
set -eu
root=$(cd "$(dirname "$0")/.." && pwd)
help() {
    cat <<'EOF'
usage: bin/rz <target> [<cmd> ...] | bin/rz raw <target>

  bin/rz exe/slus_004_22 'px 16 @ 0x8014AA04'          bytes at an address
  bin/rz exe/slus_004_22 'aaa; axt @ g_AreaMapBundle'  references to a symbol
  bin/rz exe/slus_004_22 'pdf @ SYS_Main'              the function at an address
EOF
}
case "${1:-}" in
-h | --help) help; exit 0 ;;
esac
[ "$#" -ge 1 ] || {
    help >&2
    exit 2
}
[ -x "$root/toolchains/rizin/bin/rizin" ] || {
    echo "bin/rz: rizin is missing; install it as docs/toolchain.md#matching-tools says" >&2
    exit 127
}
if [ "$1" = raw ]; then
    [ "$#" -eq 2 ] || {
        help >&2
        exit 2
    }
    target=$2
    if [ "${target%%/*}" = exe ]; then
        exec "$root/toolchains/rizin/bin/rizin" -q0 -N -a mips -b 32 -E little \
            -e asm.cpu=r3000a -e str.encoding=ascii -e scr.color=0 \
            "$root/build/bin/$target.bin"
    fi
    load=$(PYTHONPATH="$root/tools" "$root/.venv/bin/python" -c 'import sys; from pathlib import Path; from bof3.resolve import load_target_manifests; print(hex(load_target_manifests(Path(sys.argv[1]))[sys.argv[2]].load_address))' "$root" "$target")
    exec "$root/toolchains/rizin/bin/rizin" -q0 -N -a mips -b 32 -E little \
        -e asm.cpu=r3000a -e str.encoding=ascii -e scr.color=0 \
        -m "$load" "$root/build/bin/$target.bin"
fi
target=$1
shift
flat=$(printf '%s' "$target" | tr / +)
project="build/meson/rz+$flat.rzdb"
out=$(meson compile -C "$root/build/meson" "rz+$flat.rzdb" 2>&1) || {
    printf '%s\n' "$out" >&2
    exit 1
}
for cmd; do
    set -- "$@" -c "$cmd"
    shift
done
exec "$root/toolchains/rizin/bin/rizin" -q -p "$root/$project" "$@"
