root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

# Match .clang-format.
[*.{c,h}]
indent_style = space
indent_size = 4
max_line_length = 200

# Split and authored assembly use spaces.
[*.{s,inc}]
indent_style = space
indent_size = 4

[*.py]
indent_style = space
indent_size = 4

[*.{yml,yaml,toml,json}]
indent_style = space
indent_size = 2

[meson.build]
indent_style = space
indent_size = 2

[*.md]
trim_trailing_whitespace = false

# Scripts mix tabs and spaces; keep each file as it is.
[*.sh]
indent_style = unset
