# Python
__pycache__/
*.pyc
*.pyo
.pytest_cache/
.ruff_cache/
.venv
.uv-cache/
dist/
*.egg-info/

# Editor / IDE
*.swp
*.swo
*~
.vscode/
.idea/
.DS_Store

# Derived outputs (regenerable) and agent drafts
/build/
/objdiff.json
/report.json
/work/
/src/**/out/
/artifacts/

# Debug artifacts
debug_*.o
debug_*.c

# GCC RTL pass dumps (-da / -fdump-rtl-*): codegen-probe byproduct, never source.
# Run dump probes with cwd under build/ so they never reach the repo root.
*.c.rtl
*.c.jump
*.c.jump2
*.c.cse
*.c.cse2
*.c.gcse
*.c.loop
*.c.loop2
*.c.dbr
*.c.branch
*.c.regmove
*.c.combine
*.c.sched
*.c.sched2
*.c.lreg
*.c.greg
*.c.reload
*.c.postreload
*.c.flow
*.c.flow2
*.c.ce1
*.c.ce2
*.c.ce3
*.c.stack
*.c.asmcons
*.c.final
*.c.sibling
*.c.reorg
*.c.delay_slot
*.c.mach
*.c.peephole2
*.c.pro_and_epilogue
*.c.outof_cfglayout
*.c.ira
*.c.tracer
*.c.vartrack
*.c.initvals
*.c.split[0-9]
*.c.subreg[0-9]
*.c.[0-9]*

# Local inputs (user-owned disc media) and downloaded toolchains
inputs/*
!inputs/README.md
toolchains/*
!toolchains/README.md

# Runtime state (root-level only; a bare `data/` also swallowed
# include/data/ for every new file)
/data/

# Audio outputs
*.wav
*.ogg

# Compiled binaries
*.o
*.elf
*.map

# Cache
.cache/

# Local agent state and worktrees
.skill-state/
.worktrees/

# Splat disassembly (regenerated by `meson setup`); hand assembly is authored.
/asm/**/*.s
!/asm/**/hand/*.s
/asm/**/.splat.stamp
/asm/**/nonmatchings/
/asm/**/data/
/tasks/

# SDK objects never enter include/
include/**/*.[oO]
include/**/*.[oO][bB][jJ]
include/**/*.[lL][iI][bB]
